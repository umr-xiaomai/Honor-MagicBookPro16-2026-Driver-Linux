# Set default behaviour to automatically normalize line endings
* text=auto

# Enforce Unix LF line endings for all shell scripts and source code
# This prevents 'exec format error' or '\r: command not found' when run on Linux
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.asl text eol=lf
*.dsl text eol=lf
*.patch text eol=lf
*.conf text eol=lf
*.hwdb text eol=lf
*.rules text eol=lf
*.service text eol=lf
*.install text eol=lf
*.md text eol=lf

# Binary files
*.img binary
*.aml binary
*.dat binary
*.bin binary
*.png binary
*.jpg binary
