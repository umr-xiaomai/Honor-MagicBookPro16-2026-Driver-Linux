[Unit]
Description=Set HONOR battery charge limit through kernel sysfs
After=systemd-modules-load.service
StartLimitIntervalSec=60
StartLimitBurst=6

[Service]
Type=oneshot
Environment=CHARGE_LIMIT=80
EnvironmentFile=-/etc/default/honor-battery-limit
ExecStart=/usr/local/bin/honor-battery-limit ${CHARGE_LIMIT}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
